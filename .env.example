# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public origin. Must be https:// in production — bot providers refuse to post
# webhooks to plain http.
APP_URL=http://localhost:3000
# Signs session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-me-with-32-random-bytes
# Encrypts stored Google tokens. Defaults to SESSION_SECRET if unset; set it
# separately in production so rotating one doesn't invalidate the other.
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Database — Postgres with the pgvector extension
# Supabase and Neon both enable it with `create extension vector;`
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://sales:sales@localhost:5433/sales_intel

# ---------------------------------------------------------------------------
# LLM provider
# `anthropic` = Claude direct. `glm` = Z.ai's GLM models through their
# Anthropic-compatible endpoint, using the same SDK.
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic

# --- Anthropic ---
ANTHROPIC_API_KEY=
# claude-sonnet-5 is the default. claude-opus-5 is a drop-in upgrade if brief
# quality matters more than cost.
ANTHROPIC_MODEL=claude-sonnet-5
# Anthropic only — ignored when LLM_PROVIDER=glm.
ANTHROPIC_EFFORT=high

# --- GLM (Z.ai) ---
# Key from https://z.ai/manage-apikey/apikey-list
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/anthropic
GLM_MODEL=glm-5.3
# Native REST surface — used for web search, which the Anthropic-compatible
# endpoint does not provide.
GLM_API_BASE_URL=https://api.z.ai/api/paas/v4
GLM_SEARCH_ENGINE=search_std

# ---------------------------------------------------------------------------
# Embeddings — chosen independently of LLM_PROVIDER
#
# `local` is any OpenAI-compatible embedding server (Ollama, TEI, Infinity,
# vLLM, LM Studio), which is how the open-weight models below are served.
# `hash` needs no key and makes retrieval work offline, but has no semantic
# understanding — development only.
#
# Recommended models (dimension / max context / query prefix):
#   bge-m3                        1024 /  8k / none    — hybrid dense+sparse
#   qwen3-embedding-8b            4096 / 32k / Instruct — highest precision, heaviest
#   snowflake-arctic-embed-l-v2.0 1024 /  8k / "query: " — MRL to 256
#   nomic-embed-text-v2-moe        768 / 512 / "search_query: " — MoE, cheapest
#
# The prefixes are applied automatically from the registry in
# src/lib/embeddings/models.ts. EMBEDDING_DIM must match both the model's
# output and the pgvector column — a mismatch fails loudly at request time.
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
# Ollama's default. TEI is typically http://localhost:8080/v1
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=

# --- Hybrid dense + sparse (BGE-M3 only) ---
# Sparse output is not part of the OpenAI embeddings shape, so it needs a
# server that exposes it — e.g. Text Embeddings Inference's /embed_sparse.
# Leave unset to stay dense-only.
HYBRID_SEARCH=false
EMBEDDING_SPARSE_URL=
HYBRID_RRF_K=60
SPARSE_MAX_TERMS=400

# --- Hosted alternatives ---
VOYAGE_API_KEY=
# GLM embeddings are NOT on api.z.ai — they live on the legacy BigModel host.
GLM_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_EMBEDDING_MODEL=embedding-3
GLM_EMBEDDING_API_KEY=

# ---------------------------------------------------------------------------
# Google OAuth — needs the Calendar API enabled on the project
# Scopes: openid, userinfo.email, userinfo.profile, calendar.events
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
CALENDAR_LOOKAHEAD_DAYS=14

# ---------------------------------------------------------------------------
# Meeting bot
# `attendee`   the default; transcribes natively.
# `meetingbot` records only — needs TRANSCRIPTION_PROVIDER set as well.
# `mock`       simulates a whole call with a canned transcript, so the
#              post-call pipeline runs locally with no bot infrastructure.
#              Use this for development — see README.
# `noop`       schedules nothing; paste transcripts in the UI instead.
# ---------------------------------------------------------------------------
BOT_PROVIDER=mock
ATTENDEE_BASE_URL=https://app.attendee.dev
ATTENDEE_API_KEY=
MEETINGBOT_BASE_URL=
MEETINGBOT_API_KEY=
BOT_DISPLAY_NAME=Sales Notetaker
BOT_JOIN_LEAD_MINUTES=10
# Shared secret in the webhook URL. openssl rand -hex 24
WEBHOOK_SECRET=replace-me
# Guards /api/cron/*. Vercel sends this as `Authorization: Bearer <secret>`.
CRON_SECRET=replace-me

# ---------------------------------------------------------------------------
# Transcription fallback — only when the bot returns audio instead of text
# ---------------------------------------------------------------------------
TRANSCRIPTION_PROVIDER=none
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# ---------------------------------------------------------------------------
# Free tier
# ---------------------------------------------------------------------------
FREE_TIER_MEETING_LIMIT=5
